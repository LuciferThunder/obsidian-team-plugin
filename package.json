{
    "name": "obsidian-team-plugin",
    "version": "1.1.2",
    "description": "Shared vault collaboration plugin for Obsidian teams.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "lint": "eslint .",
        "version": "node version-bump.mjs && git add manifest.json versions.json"
    },
    "keywords": [
        "obsidian",
        "plugin",
        "team",
        "collaboration",
        "ai"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/node": "^20.10.0",
        "esbuild": "^0.19.0",
        "eslint": "^9.39.4",
        "eslint-plugin-obsidianmd": "^0.3.0",
        "globals": "^17.6.0",
        "obsidian": "^1.13.0",
        "tslib": "^2.6.0",
        "typescript": "^5.3.0",
        "typescript-eslint": "^8.61.1"
    },
    "dependencies": {
        "@codemirror/state": "^6.4.1",
        "@codemirror/view": "^6.26.3",
        "y-codemirror.next": "^0.3.5",
        "y-websocket": "^3.0.0",
        "yjs": "^13.6.29"
    }
